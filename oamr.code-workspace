{
  "folders": [
    {
      "name": "oamr-esp32-firmware",
      "path": "oamr-esp32-firmware"
    },
    {
      "name": "oamr-ros2-ws",
      "path": "oamr-ros2-ws"
    }
  ],
  "settings": {
    "ROS2.distro": "humble",
    "python.autoComplete.extraPaths": [
      "/opt/ros/humble/lib/python3.10/site-packages",
      "/opt/ros/humble/local/lib/python3.10/dist-packages"
    ],
    "python.analysis.extraPaths": [
      "/opt/ros/humble/lib/python3.10/site-packages",
      "/opt/ros/humble/local/lib/python3.10/dist-packages"
    ],
    "files.associations": {
      "*.launch.py": "python"
    }
  },
  "extensions": {
    "recommendations": [
      "platformio.platformio-ide",
      "ms-vscode.cpptools",
      "ms-python.python"
    ]
  }
}
